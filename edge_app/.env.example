# RoadLens Scout Edge Client Configuration
# Network & Downstream Ingestion
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_WS_BASE_URL=ws://10.0.2.2:8000/ws

# Edge Processing Limits
EXPO_PUBLIC_TARGET_FPS=5
EXPO_PUBLIC_FRAME_INTERVAL_MS=200

# Edge Sensor & Homography Defaults
EXPO_PUBLIC_DEFAULT_MOUNT_HEIGHT_M=1.25
EXPO_PUBLIC_DEFAULT_PITCH_DEG=12.0

# Storage & Logging
EXPO_PUBLIC_OFFLINE_QUEUE_MAX_SIZE=500
EXPO_PUBLIC_LOG_LEVEL=debug
