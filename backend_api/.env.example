# RoadLens Backend API Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Supabase PostgreSQL + PostGIS Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Clustering Configuration
DBSCAN_EPS_METERS=5.0
DBSCAN_TIME_WINDOW_MINUTES=15
DBSCAN_MIN_SAMPLES=2
